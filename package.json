{
  "name": "dsh-live2d-plugin",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "author": "gawuwuwu",
  "description": "Live2D desktop pet for DeepSeek Harness: multi-instance transparent always-on-top windows, chat bubbles, AI-controlled expressions and motions, screen reading, TTS with lip sync, and proactive wake-up.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "live2d",
    "cubism4",
    "desktop-pet",
    "electron",
    "tts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gawuwuwu/dsh-live2d.git"
  },
  "homepage": "https://github.com/gawuwuwu/dsh-live2d#readme",
  "bugs": {
    "url": "https://github.com/gawuwuwu/dsh-live2d/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "electron",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "tests",
    "tools"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  }
}
